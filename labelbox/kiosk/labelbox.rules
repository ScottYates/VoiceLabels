// Let @USER@ switch between the Voice Labels kiosk and the desktop without a
// password (used by "Exit to desktop" and the desktop's Voice Labels icon),
// restart or shut down the Pi from the app's Power panel, and change its IP
// address (automatic or fixed) from the Network panel.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "@USER@") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "labelbox.service" || unit == "lightdm.service") &&
            (verb == "start" || verb == "stop" || verb == "restart")) {
            return polkit.Result.YES;
        }
    }
});

polkit.addRule(function (action, subject) {
    if (subject.user == "@USER@" &&
        (action.id == "org.freedesktop.login1.reboot" ||
         action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
         action.id == "org.freedesktop.login1.power-off" ||
         action.id == "org.freedesktop.login1.power-off-multiple-sessions")) {
        return polkit.Result.YES;
    }
});

polkit.addRule(function (action, subject) {
    if (subject.user == "@USER@" &&
        (action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id == "org.freedesktop.NetworkManager.network-control")) {
        return polkit.Result.YES;
    }
});
